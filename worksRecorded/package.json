  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--inspect' next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:webhooks": "npx tsx scripts/test-whatsapp-webhooks.ts",
    "import:material-spend": "tsx scripts/import-material-spend.ts",
    "test:smoke": "bun run test/app-smoke-tests.ts",
    "test:start": "bun run test/startTest.ts",
    "eval:ai:dashboard": "tsx test/ai-evals/run-dashboard-eval.ts",
    "eval:ai:whatsapp-site-manager": "tsx test/ai-evals/run-whatsapp-site-manager-eval.ts",
    "eval:ai:whatsapp-worker": "tsx test/ai-evals/run-whatsapp-worker-eval.ts",
    "eval:ai:deterministic": "npm run eval:ai:dashboard && npm run eval:ai:whatsapp-site-manager && npm run eval:ai:whatsapp-worker",
    "eval:ai:judge": "npm run eval:ai:dashboard -- --judge && npm run eval:ai:whatsapp-site-manager -- --judge && npm run eval:ai:whatsapp-worker",
    "langgraph:dev": "npx -y @langchain/langgraph-cli@0.0.71 dev",
    "postinstall": "prisma generate",
    "test": "jest",
    "test:unit": "jest --runInBand",
    "test:image-extraction": "cross-env RUN_AI_EVALS=false RUN_META_IMAGE_AI_EVAL=false jest --runInBand test/meta-image-handler-langsmith.test.ts test/meta-image-upload-material-extraction.test.ts",
    "test:image-extraction:real": "cross-env RUN_AI_EVALS=true RUN_META_IMAGE_AI_EVAL=true jest --runInBand test/meta-image-real-extraction.eval.test.ts",
    "test:ai:validators": "jest --runInBand test/ai-evals",
    "test:ai:dry-run": "npm run eval:ai:dashboard -- --dry-run && npm run eval:ai:whatsapp-site-manager -- --dry-run && npm run eval:ai:whatsapp-worker -- --dry-run",
    "test:all": "npm run test:unit && npm run test:ai:dry-run"
  },
