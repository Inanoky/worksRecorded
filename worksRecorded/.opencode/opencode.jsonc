{
	"$schema": "https://opencode.ai/config.json",
	"model": "openai/gpt-5.5",
	"small_model": "openai/gpt-5.5",
	"instructions": ["AGENTS.md"],
	"references": {
		"docs": {
			"path": "docs",
			"description": "Use for AI context engineering, LangGraph checkpoint memory, WhatsApp webhook routing, n8n/Supabase database webhooks, and rollout checklists."
		},
		"flows": {
			"path": "flows",
			"description": "Use for build-time flow module definitions (module.ts / frontend.ts / backend.ts) and the flow authoring checklist."
		},
		"ai-evals": {
			"path": "test/ai-evals",
			"description": "Use for AI eval suites: dashboard / whatsapp-site-manager / whatsapp-worker cases, validators, runners, and the command layer table."
		}
	},
	"mcp": {
		"supabase": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"mcp-remote@0.1.37",
				"https://mcp.supabase.com/mcp?project_ref=wfsvrqtzsaqngbrbatfp&read_only=true&features=docs%2Cdebugging%2Cdevelopment"
			],
			"enabled": false
		},
		"playwright": {
			"type": "local",
			"command": ["npx", "-y", "@playwright/mcp"],
			"enabled": true
		},
		"context7": {
			"type": "local",
			"command": ["npx", "-y", "@upstash/context7-mcp"],
			"enabled": true
		},
		"langsmith": {
			"type": "local",
			"command": [
        "zsh",
        "-lc",
        "set -a; [ -f .env ] && source .env; exec uvx langsmith-mcp-server"
  ],
			"enabled": true,
			"environment": {
				"LANGSMITH_API_KEY": "{env:LANGSMITH_API_KEY}",
				"LANGSMITH_ENDPOINT": "https://api.smith.langchain.com"
			}
		}
	},
	"permission": {
		"read": "allow",
		"glob": "allow",
		"grep": "allow",
		"list": "allow",
		"task": "allow",
		"external_directory": { "*": "ask", "~/.config/opencode/**": "allow", "~/.local/share/opencode/**": "allow" },
		"edit": { "*": "ask", ".env": "deny", "prisma/migrations/**": "deny", ".ai-eval-results/**": "deny" },
		"bash": {
			"*": "allow",
			"node *": "allow",
			"mkdir *": "allow",
			"rm *": "ask",
			"rm -rf *": "deny",
			"rm -rf .git*": "deny",
			"git clean*": "ask",
			"git checkout -- *": "ask",
			"git push*": "ask",
			"git commit*": "ask",
			"git reset --hard*": "ask",
			"sudo *": "ask",
			"prisma migrate*": "ask",
			"npx prisma db push*": "ask",
			"npm run eval:ai:*": "ask"
		}
	}
}
