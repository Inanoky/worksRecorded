[Unit]
Description=WorksRecorded WhatsApp browser diary synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=worksrecorded
WorkingDirectory=/opt/worksrecorded
EnvironmentFile=/etc/worksrecorded/whatsapp-browser-sync.env
ExecStart=/usr/bin/npm run whatsapp-browser:once
TimeoutStartSec=15min
UMask=0077

[Install]
WantedBy=multi-user.target
