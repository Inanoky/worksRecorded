{
	"$schema": "https://biomejs.dev/schemas/2.2.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"root": ".."
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/.next",
			"!**/node_modules",
			"!**/.git",
			"!**/.vercel",
			"!**/.swc",
			"!**/.tmp",
			"!**/coverage",
			"!**/playwright-report",
			"!**/test-results",
			"!**/blob-report",
			"!**/.ai-eval-results",
			"!**/.market-build",
			"!**/outputs",
			"!**/worksRecorded.git",
			"!out",
			"!build",
			"!dist"
		],
		"experimentalScannerIgnores": [
			".git",
			".hg",
			".svn",
			".next",
			"node_modules",
			".vercel",
			".swc",
			".tmp",
			"coverage",
			"playwright-report",
			"test-results",
			"blob-report",
			".ai-eval-results",
			".market-build",
			"outputs",
			"worksRecorded.git",
			"out",
			"build",
			"dist"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
